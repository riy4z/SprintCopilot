{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/health": {
            "get": {
                "description": "Check if server, Redis, Jira, and OpenAI are accessible",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/jira/callback": {
            "get": {
                "description": "Handles OAuth callback from Jira Cloud and exchanges authorization code for an access token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "OAuth"
                ],
                "summary": "Jira OAuth callback",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authorization code returned by Atlassian",
                        "name": "code",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "OAuth state value",
                        "name": "state",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Access token response",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Token exchange failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/jira/oauth": {
            "get": {
                "description": "Redirects user to Jira Cloud OAuth2 login page",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "OAuth"
                ],
                "summary": "Connect Jira OAuth",
                "responses": {
                    "307": {
                        "description": "Redirect",
                        "schema": {
                            "type": "string"
                        },
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "OAuth login URL"
                            }
                        }
                    }
                }
            }
        },
        "/jira/projects": {
            "get": {
                "description": "Fetch all Jira projects from the connected Jira cloud instance",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Jira"
                ],
                "summary": "Get Jira Projects",
                "responses": {
                    "200": {
                        "description": "List of Jira projects",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/jira.ProjectResponse"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/jira/projects/{projectKey}/team": {
            "get": {
                "description": "Fetch all assignable team members for a specific Jira project",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Jira"
                ],
                "summary": "Get Team Members by Project",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"SCO\"",
                        "description": "Project Key",
                        "name": "projectKey",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Project team members with velocity data",
                        "schema": {
                            "$ref": "#/definitions/jira.ProjectTeamResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid project key",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/jira/{projectKey}/backlogs": {
            "get": {
                "description": "Fetch all backlog issues (unassigned to sprints) for a specific Jira project",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Jira"
                ],
                "summary": "Get Jira Backlog Issues",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"SCO\"",
                        "description": "Project Key",
                        "name": "projectKey",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Backlog tickets with metadata",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid project key",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/jira/{projectKey}/dependency-graph": {
            "get": {
                "description": "Fetch dependency graph with nodes and edges for backlog issues, including cycle detection",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Jira"
                ],
                "summary": "Get Dependency Graph for Project Backlog",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"SCO\"",
                        "description": "Project Key",
                        "name": "projectKey",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Dependency graph with nodes and edges",
                        "schema": {
                            "$ref": "#/definitions/jira.DependencyGraphData"
                        }
                    },
                    "400": {
                        "description": "Invalid project key",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/jira/{projectKey}/sprints": {
            "get": {
                "description": "Fetch all sprints for a specific Jira project using JQL search",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Jira"
                ],
                "summary": "Get Sprints by Project",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"SCO\"",
                        "description": "Project Key",
                        "name": "projectKey",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of sprint data",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid project key",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "jira.DependencyEdge": {
            "type": "object",
            "properties": {
                "from": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "jira.DependencyGraphData": {
            "type": "object",
            "properties": {
                "edges": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/jira.DependencyEdge"
                    }
                },
                "nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/jira.DependencyNode"
                    }
                }
            }
        },
        "jira.DependencyNode": {
            "type": "object",
            "properties": {
                "assignee": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "isBlocked": {
                    "type": "boolean"
                },
                "isBlocker": {
                    "type": "boolean"
                },
                "isInCycle": {
                    "type": "boolean"
                },
                "isSprintSafe": {
                    "type": "boolean"
                },
                "priority": {
                    "type": "string"
                },
                "summary": {
                    "type": "string"
                }
            }
        },
        "jira.ProjectCategory": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "jira.ProjectResponse": {
            "type": "object",
            "properties": {
                "Avatar": {
                    "type": "string"
                },
                "Category": {
                    "type": "string"
                },
                "avatarUrls": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "id": {
                    "type": "string"
                },
                "key": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "projectCategory": {
                    "$ref": "#/definitions/jira.ProjectCategory"
                },
                "sprintGraph": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/jira.SprintData"
                    }
                },
                "teamSize": {
                    "type": "integer"
                },
                "velocity": {
                    "type": "integer"
                }
            }
        },
        "jira.ProjectTeamResponse": {
            "type": "object",
            "properties": {
                "projectKey": {
                    "type": "string"
                },
                "teamMembers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/jira.TeamMember"
                    }
                },
                "velocity": {
                    "type": "integer"
                }
            }
        },
        "jira.SprintData": {
            "type": "object",
            "properties": {
                "sprintName": {
                    "type": "string"
                },
                "velocity": {
                    "type": "integer"
                }
            }
        },
        "jira.TeamMember": {
            "type": "object",
            "properties": {
                "avatarUrl": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "sprintHistory": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                },
                "userId": {
                    "type": "string"
                },
                "velocity": {
                    "type": "integer"
                }
            }
        }
    }
}